root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{h,hpp,cpp,cc,cxx}]
indent_size = 4

[*.qml]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.sh]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
