{
  "name": "libdatachannel",
  "version-semver": "0.24.5",
  "port-version": 1,
  "description": "libdatachannel with libnice for TURN UDP, TCP and TLS",
  "homepage": "https://github.com/paullouisageneau/libdatachannel",
  "license": "MPL-2.0",
  "supports": "!xbox",
  "dependencies": [
    "libnice",
    "nlohmann-json",
    "openssl",
    "plog",
    "usrsctp",
    {
      "name": "pkgconf",
      "host": true
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "ws"
  ],
  "features": {
    "srtp": {
      "description": "Media transport",
      "dependencies": [
        "libsrtp"
      ]
    },
    "ws": {
      "description": "WebSockets"
    },
    "stdcall": {
      "description": "C API stdcall convention"
    }
  }
}
